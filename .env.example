# ==============================================================================
# TriadCouncil Multi-Agent Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# ==============================================================================

# 1. OpenRouter API Key (Manager Role)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 2. Google Gemini API Key (Researcher & Senior Dev Roles)
# Get your free key at: https://aistudio.google.com/app/api-keys
# NOTE: This single key powers BOTH the Researcher's Google Search grounding
# AND the Google Antigravity SDK for the Senior Dev.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RESEARCHER_MODEL=gemini-2.5-flash

# 3. Groq API Key (Junior Dev 1 - Candidate A)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# 4. ZhipuAI GLM-4-Flash Keys (100% Free - Junior Dev 2 & QA Red-Teamer)
# Get your free keys at: https://bigmodel.cn
# You can use two separate keys for the Co-Dev and QA Auditor to isolate rate limits:
ZHIPUAI_DEV_API_KEY=your_zhipuai_dev_key_here
ZHIPUAI_QA_API_KEY=your_zhipuai_qa_key_here
GLM_MODEL=glm-4-flash

# 5. Optional Operational Controls
AI_TEAM_RUNS_DIR=.runs
AI_TEAM_EXECUTION_TIMEOUT_SECONDS=120
AI_TEAM_MAX_RETRY_ATTEMPTS=2
AI_TEAM_SERVER_HOST=0.0.0.0
AI_TEAM_SERVER_PORT=8000

# ==============================================================================
# TriadCouncil Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Every role degrades independently. A missing key never fabricates a result:
# an unreachable auditor reports "QA unavailable", and a developer with no
# provider reports no implementation, which then fails QA.
# ==============================================================================

# 1. OpenRouter - Manager (RFC, acceptance criteria, final report)
#    https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 2. Groq - Developer, Researcher, and the frozen TDD contract author
#    https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# Optionally a second Groq key so the researcher/TDD role has its own rate limit
GROQ_RESEARCHER_API_KEY=
GROQ_RESEARCHER_MODEL=openai/gpt-oss-120b

# 3. ZhipuAI GLM-4-Flash - QA auditor (free)
#    https://bigmodel.cn
#    Two keys may be used to isolate rate limits between roles.
ZHIPUAI_QA_API_KEY=your_zhipuai_qa_key_here
ZHIPUAI_DEV_API_KEY=
GLM_MODEL=glm-4-flash

# 4. Google Gemini - Developer fallback provider
#    https://aistudio.google.com/app/api-keys
#    NOTE: the Researcher does NOT currently use Gemini Search grounding; it
#    runs on Groq and does not perform live web search.
#    NOTE: if the Antigravity adapter is ever revived, it reads GEMINI_API_KEY.
#    That name is fixed by the SDK and must not be renamed.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RESEARCHER_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Sandbox isolation
# ------------------------------------------------------------------------------
# Approved code runs only inside this container. If Docker is unavailable the
# run is refused; there is no host fallback. Build the image once with:
#   docker build -t triadcouncil-sandbox:py312 -f docker/sandbox.Dockerfile docker/
AI_TEAM_SANDBOX=docker
AI_TEAM_SANDBOX_IMAGE=triadcouncil-sandbox:py312
# Container user. Change this if bind-mount writes fail on your platform.
AI_TEAM_SANDBOX_UID=65534:65534
AI_TEAM_SANDBOX_MEMORY=512m
AI_TEAM_SANDBOX_CPUS=1
AI_TEAM_SANDBOX_PIDS_LIMIT=128

# ------------------------------------------------------------------------------
# Operational
# ------------------------------------------------------------------------------
AI_TEAM_RUNS_DIR=.runs
AI_TEAM_EXECUTION_TIMEOUT_SECONDS=120
AI_TEAM_MAX_RETRY_ATTEMPTS=2

# Loopback by default. This server exposes the approval gate, so do not bind it
# to 0.0.0.0 until per-run tokens are enforced end to end.
AI_TEAM_SERVER_HOST=127.0.0.1
AI_TEAM_SERVER_PORT=8000
# The uvicorn reloader runs a filesystem watcher for the life of the process.
AI_TEAM_SERVER_RELOAD=0

# ------------------------------------------------------------------------------
# Provider resilience
# ------------------------------------------------------------------------------
AI_TEAM_PROVIDER_MAX_RETRIES=3
AI_TEAM_PROVIDER_BACKOFF_BASE_SECONDS=2.0
AI_TEAM_PROVIDER_BACKOFF_MAX_SECONDS=30.0
AI_TEAM_PROVIDER_QUOTA_COOLDOWN_SECONDS=3600

# ------------------------------------------------------------------------------
# Office simulation
# ------------------------------------------------------------------------------
# One simulated 09:00-17:00 workday compressed into this many real seconds.
AI_TEAM_WORKDAY_REAL_SECONDS=1200
AI_TEAM_OFF_HOURS_REAL_SECONDS=1200
AI_TEAM_TERMINAL_LOG_LIMIT=500

# ------------------------------------------------------------------------------
# Observability (optional)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=triadcouncil
